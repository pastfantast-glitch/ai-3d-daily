      "evidence_refs": [
        "p009",
        "p011",
        "p012",
        "p015",
        "p020",
        "p024",
        "p022",
        "p025",
        "p026"
      ],
      "full_analysis": [
        {
          "label": "烘焙修正技術流程",
          "text": "Skew 控制烘焙射線方向，Cage 則控制射線距離；兩者把 Painter 的繪製系統帶入烘焙模式，並以隱藏圖層堆疊保存修正資訊，再由自動重烘焙提供近即時預覽。",
          "evidence_refs": [
            "p009",
            "p011",
            "p012"
          ]
        },
        {
          "label": "資產迭代製作影響",
          "text": "Cage 可利用重新設計的多邊形填滿工具，為個別物件加入相對偏移，不必離開 Painter 另做 Cage；材質組反白也能從清單或視窗反查複雜多材質網格。",
          "evidence_refs": [
            "p015",
            "p020",
            "p024"
          ]
        },
        {
          "label": "節點與透明限制待驗證",
          "text": "Imager 以外的本次訪談重點仍是操作流程，沒有量化烘焙速度；透明排序只針對即時視窗改善，且團隊明言部分選項仍會在後續小版更新持續補足。",
          "evidence_refs": [
            "p022",
            "p025",
            "p026"
          ]
        }
      ],
