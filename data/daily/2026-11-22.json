  "items": [
    {
      "id": "80-level-building-detailed-caribbean-inspired-city-environment-in-u-186b7ab2b3cc9491",
      "topic_ids": [
        "ai-3d"
      ],
      "title": "加勒比街巷場景：以雙 UV、共用遮罩與模組建築製作材質變化",
      "summary": "Santiago Forero 在 Unreal Engine 5 製作加勒比街巷，以可互換的牆面與門組成建築，再用頂點繪製、RGB 遮罩和 Substance 3D Designer 材質庫表現磚牆、灰泥與路面。",
      "quick_impact": "★★★★☆",
      "source_url": "https://80.lv/articles/building-detailed-caribbean-inspired-city-environment-in-unreal-engine-5",
      "category": "engine-art",
      "subcategory": "unreal",
      "ranking_score": 88.84,
      "base_ranking_score": 84.0,
      "source_published_at": "2026-11-20",
      "analysis_level": "FULL",
      "content_kind": "practice",
      "brief_reason": "practical-tutorial-limited-depth",
      "full_analysis": [
        {
          "label": "模組與雙 UV 配合",
          "text": "作者將一樓牆面、二樓、陽台與門設計成可互換模組；部分資產使用兩組 UV，第一組維持平鋪材質的紋理密度，第二組存放共用 RGB 遮罩，分別處理材質尺度與局部表面變化。",
          "angle": "workflow_or_technical_change"
        },
        {
          "label": "共用素材支援場景反覆調整",
          "text": "磚、灰泥、木材與路面組成可重複使用的材質庫，牆面以頂點繪製混合材質，道具則用 RGB 遮罩控制分區。作者指出，及早建立材質庫讓場景迭代更有效率，也減少持續新增獨立貼圖的需求。",
          "angle": "production_impact"
        },
        {
          "label": "重複模組與日光平衡的難點",
          "text": "作者提到，模組必須相互接合又不顯得重複，這在初期曾是挑戰；約兩個月的製作中，最難的是戶外光照，需要反覆平衡直射光、環境光與場景氣氛，讓建築材質和主視覺同時成立。",
          "angle": "test_risk_or_limit"
        }
      ],
      "rank_global": 1,
      "homepage_tier": "top5"
    },
    {
      "id": "cg-channel-tutorial-check-out-this-essential-introduction-to-unreal-99c74c7e161850cf",
      "topic_ids": [
        "ai-3d"
      ],
      "title": "UE5 入門課程：從場景組裝、材質到電影鏡頭渲染",
      "summary": "Eric Roin 為 The Gnomon Workshop 製作超過八小時的 Unreal Engine 5 入門教學，涵蓋場景組裝、材質、Sequencer、燈光與最終輸出，最後將流程整合進示範場景。",
      "quick_impact": "★★★★☆",
      "source_url": "https://www.cgchannel.com/2026/11/tutorial-check-out-this-essential-introduction-to-unreal-engine-5",
      "category": "engine-art",
      "subcategory": "unreal",
      "ranking_score": 86.42,
      "base_ranking_score": 84.0,
      "source_published_at": "2026-11-20",
      "analysis_level": "BRIEF",
      "content_kind": "practice",
      "brief_reason": "practical-tutorial-limited-depth",
      "full_analysis": [
        {
          "label": "從場景素材到電影輸出",
          "text": "課程由介面、專案整理和場景組裝開始，再介紹主材質、材質實例、材質函式與 Substrate；後段使用 Sequencer 製作鏡頭，並以 Movie Render Queue 與 Movie Render Graph 輸出示範場景。",
          "angle": "workflow_or_technical_change"
        },
