{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config/collection-session.schema.json",
  "title": "AI 3D Daily Collection Session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "date",
    "discovery_coverage",
    "candidate_decisions",
    "personalization"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "date": {"type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"},
    "discovery_coverage": {
      "type": "object",
      "required": [
        "fill_ladder_exhausted",
        "backlog_checked",
        "backlog_remaining_eligible",
        "targeted_refill_performed",
        "quality_first_confirmed",
        "windows",
        "category_candidates"
      ]
    },
    "candidate_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["candidate_id", "source_url", "discovery_channels", "decision"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "source_url": {"type": "string", "pattern": "^https?://"},
          "discovery_channels": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "decision": {
            "enum": ["published", "duplicate", "rejected", "ranked-out", "backlog"]
          },
          "canonical_id": {"type": "string", "minLength": 1},
          "reason_code": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"decision": {"const": "published"}}},
            "then": {"required": ["canonical_id"]},
            "else": {"required": ["reason_code"]}
          }
        ]
      }
    },
    "personalization": {
      "type": "object",
      "required": [
        "contract",
        "status",
        "vote_count",
        "max_rank_multiplier",
        "max_query_expansion_fraction",
        "raw_profile_committed",
        "bookmarks_used",
        "domain_weights_used",
        "admission_bypass",
        "quality_gate_bypass",
        "source_quota"
      ],
      "properties": {
        "contract": {"type": "string"},
        "status": {"enum": ["applied", "empty", "unavailable"]},
        "vote_count": {"type": "integer", "minimum": 0},
        "profile_fingerprint": {"type": "string"},
        "reason": {"type": "string"},
        "max_rank_multiplier": {"type": "number", "minimum": 0},
        "max_query_expansion_fraction": {"type": "number", "minimum": 0},
        "raw_profile_committed": {"const": false},
        "bookmarks_used": {"const": false},
        "domain_weights_used": {"const": false},
        "admission_bypass": {"const": false},
        "quality_gate_bypass": {"const": false},
        "source_quota": {"const": false}
      }
    }
  }
}
